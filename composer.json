{
  "name": "mailinfra/mailinfra",
  "description": "Официальный SDK MailInfra для PHP — email API для разработчиков",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "mailinfra",
    "email",
    "transactional-email",
    "smtp",
    "api-client",
    "webhooks"
  ],
  "homepage": "https://docs.mailinfra.ru",
  "support": {
    "docs": "https://docs.mailinfra.ru/sdk/php",
    "issues": "https://github.com/g7AzaZLO/mailinfra-php/issues",
    "source": "https://github.com/g7AzaZLO/mailinfra-php"
  },
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.12",
    "friendsofphp/php-cs-fixer": "^3.64"
  },
  "autoload": {
    "psr-4": {
      "MailInfra\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MailInfra\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "php-cs-fixer fix --dry-run --diff",
    "fix": "php-cs-fixer fix",
    "analyse": "phpstan analyse"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
